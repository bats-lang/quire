(* text_tables -- the single-byte encodings a document may declare, and the labels that name
   them. GENERATED by scripts/gen-encodings.py: do not edit. *)

#include "share/atspre_staload.hats"
#use array as A

(* How a document's bytes are read: UTF-8, UTF-16 (either order), one of the single-byte encodings, or an
   encoding Quire has no table for *)
#pub datatype text_source = SrcUtf8 | SrcUtf16Le | SrcUtf16Be | SrcUnsupported | SrcCp1250 | SrcCp1251 | SrcCp1252 | SrcCp1253 | SrcCp1254 | SrcCp1255 | SrcCp1256 | SrcCp1257 | SrcIso88592 | SrcIso88595 | SrcIso88597 | SrcIso88598 | SrcIso885915 | SrcKoi8r

fn _hex_value (digit: int): int =
  if digit >= 97 then digit - 87 else digit - 48

(* The code point for the byte at index (0 to 127: the bytes 128 to 255) of a table of 4 hex digits each *)
fn _table_code {n:nat} (table: string n, index: int): int = let
  val k = g1ofg0(index)
  val length = g1u2i(string1_length(table))
in
  if k < 0 then 65533
  else if 4 * k + 3 >= length then 65533
  else _hex_value(char2int0(string_get_at(table, 4 * k))) * 4096 + _hex_value(char2int0(string_get_at(table, 4 * k + 1))) * 256
       + _hex_value(char2int0(string_get_at(table, 4 * k + 2))) * 16 + _hex_value(char2int0(string_get_at(table, 4 * k + 3)))
end

(* The code point a byte of 128 to 255 stands for in a single-byte source; U+FFFD for any other source *)
#pub fn text_table_code (source: text_source, byte_value: int): int

implement text_table_code (source, byte_value) = let
  val index = byte_value - 128
in
  case+ source of
  | SrcCp1250() => _table_code("", index)
  | SrcCp1251() => _table_code("", index)
  | SrcCp1252() => _table_code("", index)
  | SrcCp1253() => _table_code("", index)
  | SrcCp1254() => _table_code("", index)
  | SrcCp1255() => _table_code("", index)
  | SrcCp1256() => _table_code("", index)
  | SrcCp1257() => _table_code("", index)
  | SrcIso88592() => _table_code("", index)
  | SrcIso88595() => _table_code("", index)
  | SrcIso88597() => _table_code("", index)
  | SrcIso88598() => _table_code("", index)
  | SrcIso885915() => _table_code("", index)
  | SrcKoi8r() => _table_code("", index)
  | SrcUtf8() => 65533
  | SrcUtf16Le() => 65533
  | SrcUtf16Be() => 65533
  | SrcUnsupported() => 65533
end

(* Whether data[offset, offset + span_len), in lower case, is text (lower case), from position *)
fun _label_from {l:agz}{n:pos}{offset,span_len:nat | offset + span_len <= n}{text_len:nat}{position:nat | position <= text_len} .<text_len - position>.
  (data: !$A.borrow(byte, l, n), offset: int offset, span_len: int span_len, text: string text_len, text_len: int text_len, position: int position): bool =
  if position >= text_len then true
  else if position >= span_len then false
  else let
    val letter = byte2int0($A.read<byte>(data, offset + position))
    val letter = (if letter >= 65 then (if letter <= 90 then letter + 32 else letter) else letter): int
  in if letter <> char2int0(string_get_at(text, position)) then false else _label_from(data, offset, span_len, text, text_len, position + 1) end

fn _label_is {l:agz}{n:pos}{offset,span_len:nat | offset + span_len <= n}{text_len:nat}
  (data: !$A.borrow(byte, l, n), offset: int offset, span_len: int span_len, text: string text_len): bool = let
  val text_len = g1u2i(string1_length(text))
in if span_len <> text_len then false else _label_from(data, offset, span_len, text, text_len, 0) end

(* The encoding a label names (an XML declaration's encoding="..."), in any case. A UTF-16 label names UTF-16
   little endian: the order of a document is its byte order mark's, and a document that is bytes of text
   and says UTF-16 is read as UTF-8 (text_encoding) *)
#pub fn text_source_of_label {l:agz}{n:pos}{offset,span_len:nat | offset + span_len <= n}
  (data: !$A.borrow(byte, l, n), offset: int offset, span_len: int span_len): text_source

implement text_source_of_label (data, offset, span_len) =
  if _label_is(data, offset, span_len, "utf-8") then SrcUtf8()
  else if _label_is(data, offset, span_len, "utf8") then SrcUtf8()
  else if _label_is(data, offset, span_len, "unicode-1-1-utf-8") then SrcUtf8()
