staload "fields.sats"
staload "schema.sats"
staload "record.sats"

#pub datasort wordx =
  | wordx_mk of (int, int, int, int, int, bytes, int, int, int, int, int, bytes, bytes, int, int, int, bytes)

#pub stadef WORD_SPECS = gs_cons(bcons(66, bcons(79, bcons(79, bcons(75, bnil())))), lo_i32(lo_i32(lo_nil())), m_req(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(67, bcons(79, bcons(85, bcons(78, bnil())))), lo_i32(lo_i32(lo_i32(lo_nil()))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_nil()))), gs_cons(bcons(76, bcons(65, bcons(78, bcons(71, bnil())))), lo_str(lo_nil()), m_req(), fv_str(bnil(), fv_nil()), gs_cons(bcons(77, bcons(79, bcons(68, bcons(70, bnil())))), lo_i32(lo_i32(lo_nil())), m_opt(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(80, bcons(76, bcons(67, bcons(69, bnil())))), lo_i32(lo_i32(lo_i32(lo_nil()))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_nil()))), gs_cons(bcons(83, bcons(69, bcons(78, bcons(84, bnil())))), lo_str(lo_str(lo_nil())), m_opt(), fv_str(bnil(), fv_str(bnil(), fv_nil())), gs_cons(bcons(83, bcons(84, bcons(65, bcons(84, bnil())))), lo_i32(lo_i32(lo_i32(lo_nil()))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_nil()))), gs_cons(bcons(87, bcons(79, bcons(82, bcons(68, bnil())))), lo_str(lo_nil()), m_req(), fv_str(bnil(), fv_nil()), gs_nil()))))))))

#pub stadef WORD_KIND = 3

#pub fun word_specs (): specsv(WORD_SPECS, 8)

implement word_specs () = SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil()))))))) | blist_cons(66, blist_cons(79, blist_cons(79, blist_cons(75, blist_nil())))), LYV_i32(LYV_i32(LYV_nil())), ModeReq(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_nil())), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil())))))) | blist_cons(67, blist_cons(79, blist_cons(85, blist_cons(78, blist_nil())))), LYV_i32(LYV_i32(LYV_i32(LYV_nil()))), ModeOpt(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_nil()))), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil()))))) | blist_cons(76, blist_cons(65, blist_cons(78, blist_cons(71, blist_nil())))), LYV_str(LYV_nil()), ModeReq(), FVV_str(blist_nil(), FVV_nil()), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil())))) | blist_cons(77, blist_cons(79, blist_cons(68, blist_cons(70, blist_nil())))), LYV_i32(LYV_i32(LYV_nil())), ModeOpt(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_nil())), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil()))) | blist_cons(80, blist_cons(76, blist_cons(67, blist_cons(69, blist_nil())))), LYV_i32(LYV_i32(LYV_i32(LYV_nil()))), ModeOpt(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_nil()))), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil())) | blist_cons(83, blist_cons(69, blist_cons(78, blist_cons(84, blist_nil())))), LYV_str(LYV_str(LYV_nil())), ModeOpt(), FVV_str(blist_nil(), FVV_str(blist_nil(), FVV_nil())), SPV_cons(TAGNOT_mk(), NOTKNOWN_cons(TAGDIFF_mk(), NOTKNOWN_nil()) | blist_cons(83, blist_cons(84, blist_cons(65, blist_cons(84, blist_nil())))), LYV_i32(LYV_i32(LYV_i32(LYV_nil()))), ModeOpt(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_i32(int32_zero(), FVV_nil()))), SPV_cons(TAGNOT_mk(), NOTKNOWN_nil() | blist_cons(87, blist_cons(79, blist_cons(82, blist_cons(68, blist_nil())))), LYV_str(LYV_nil()), ModeReq(), FVV_str(blist_nil(), FVV_nil()), SPV_nil()))))))))

(* WORDV(word_value, vals): the values of the groups are the fields of the word word_value (keyword: vocabulary) *)
#pub dataprop WORDV(wordx, gvals) =
  | {book_high,book_low,lookups,first_minute,last_minute,modified,deleted,chapter,node,offset,mastered,streak,due:int}{language,sentence_head,sentence_tail,word:bytes}
    WORDV_mk(wordx_mk(book_high, book_low, lookups, first_minute, last_minute, language, modified, deleted, chapter, node, offset, sentence_head, sentence_tail, mastered, streak, due, word), gv_cons(fv_i32(book_high, fv_i32(book_low, fv_nil())), gv_cons(fv_i32(lookups, fv_i32(first_minute, fv_i32(last_minute, fv_nil()))), gv_cons(fv_str(language, fv_nil()), gv_cons(fv_i32(modified, fv_i32(deleted, fv_nil())), gv_cons(fv_i32(chapter, fv_i32(node, fv_i32(offset, fv_nil()))), gv_cons(fv_str(sentence_head, fv_str(sentence_tail, fv_nil())), gv_cons(fv_i32(mastered, fv_i32(streak, fv_i32(due, fv_nil()))), gv_cons(fv_str(word, fv_nil()), gv_nil())))))))))

#pub datavtype wordv(wordx) =
  | {book_high,book_low,lookups,first_minute,last_minute,modified,deleted,chapter,node,offset,mastered,streak,due:int}{language,sentence_head,sentence_tail,word:bytes}{language_len,sentence_head_len,sentence_tail_len,word_len:nat | language_len < 256; sentence_head_len < 256; sentence_tail_len < 256; word_len < 256}
    WordV(wordx_mk(book_high, book_low, lookups, first_minute, last_minute, language, modified, deleted, chapter, node, offset, sentence_head, sentence_tail, mastered, streak, due, word)) of (int32v(book_high), int32v(book_low), int32v(lookups), int32v(first_minute), int32v(last_minute), blist(language, language_len), int32v(modified), int32v(deleted), int32v(chapter), int32v(node), int32v(offset), blist(sentence_head, sentence_head_len), blist(sentence_tail, sentence_tail_len), int32v(mastered), int32v(streak), int32v(due), blist(word, word_len))

(* The record as the values of its groups, with the proof that they are its fields (keyword: vocabulary) *)
#pub fun word_to_vals {word_value:wordx} (word: !wordv(word_value)): [vals:gvals] (WORDV(word_value, vals) | gvalsv(WORD_SPECS, vals, 8))

implement word_to_vals {word_value} (word) =
  case+ word of
  | WordV(book_high, book_low, lookups, first_minute, last_minute, language, modified, deleted, chapter, node, offset, sentence_head, sentence_tail, mastered, streak, due, word) => (WORDV_mk() | 
    GVV_cons(FVV_i32(int32_copy(book_high), FVV_i32(int32_copy(book_low), FVV_nil())), GVV_cons(FVV_i32(int32_copy(lookups), FVV_i32(int32_copy(first_minute), FVV_i32(int32_copy(last_minute), FVV_nil()))), GVV_cons(FVV_str(blist_copy(language), FVV_nil()), GVV_cons(FVV_i32(int32_copy(modified), FVV_i32(int32_copy(deleted), FVV_nil())), GVV_cons(FVV_i32(int32_copy(chapter), FVV_i32(int32_copy(node), FVV_i32(int32_copy(offset), FVV_nil()))), GVV_cons(FVV_str(blist_copy(sentence_head), FVV_str(blist_copy(sentence_tail), FVV_nil())), GVV_cons(FVV_i32(int32_copy(mastered), FVV_i32(int32_copy(streak), FVV_i32(int32_copy(due), FVV_nil()))), GVV_cons(FVV_str(blist_copy(word), FVV_nil()), GVV_nil())))))))))

(* The record made of the values of its groups, with the proof that they are its fields (keyword: vocabulary) *)
#pub fun word_of_vals {vals:gvals}{value_count:nat} (vals: gvalsv(WORD_SPECS, vals, value_count)): [word_value:wordx] (WORDV(word_value, vals) | wordv(word_value))

implement word_of_vals {vals}{value_count} (vals) =
  case+ vals of
  | ~GVV_cons(~FVV_i32(book_high, ~FVV_i32(book_low, ~FVV_nil())), ~GVV_cons(~FVV_i32(lookups, ~FVV_i32(first_minute, ~FVV_i32(last_minute, ~FVV_nil()))), ~GVV_cons(~FVV_str(language, ~FVV_nil()), ~GVV_cons(~FVV_i32(modified, ~FVV_i32(deleted, ~FVV_nil())), ~GVV_cons(~FVV_i32(chapter, ~FVV_i32(node, ~FVV_i32(offset, ~FVV_nil()))), ~GVV_cons(~FVV_str(sentence_head, ~FVV_str(sentence_tail, ~FVV_nil())), ~GVV_cons(~FVV_i32(mastered, ~FVV_i32(streak, ~FVV_i32(due, ~FVV_nil()))), ~GVV_cons(~FVV_str(word, ~FVV_nil()), ~GVV_nil())))))))) => (WORDV_mk() | WordV(book_high, book_low, lookups, first_minute, last_minute, language, modified, deleted, chapter, node, offset, sentence_head, sentence_tail, mastered, streak, due, word))


(* what reading a stored word comes to (keyword: vocabulary) *)
#pub datasort wordres =
  | wr_ok of (wordx, int, int, extras)
  | wr_loss of (wordx, int, int, extras, lost)
  | wr_notquire of ()
  | wr_newer of ()
  | wr_damaged of ()

(* WORDENC(word_value, format_version, least_version, kept_extras, octets): octets is the word word_value, written in the format format_version, readable from least_version, with the chunks kept_extras kept (keyword: vocabulary) *)
#pub dataprop WORDENC(wordx, int, int, extras, bytes) =
  | {word_value:wordx}{format_version,least_version:int}{kept_extras:extras}{vals:gvals}{octets:bytes}
    WORDENC_mk(word_value, format_version, least_version, kept_extras, octets) of (WORDV(word_value, vals), ENCODES(WORD_SPECS, WORD_KIND, rx_mk(format_version, least_version, vals, kept_extras, ab_nil()), octets))

(* WORDDEC(octets, outcome): reading octets as a word comes to outcome (keyword: vocabulary) *)
#pub dataprop WORDDEC(bytes, wordres) =
  | {word_value:wordx}{format_version,least_version:int}{kept_extras:extras}{missing_groups:absent}{vals:gvals}{octets:bytes}
    WORDDEC_ok(octets, wr_ok(word_value, format_version, least_version, kept_extras)) of (WORDV(word_value, vals), DECODES(WORD_SPECS, WORD_KIND, octets, rr_ok(rx_mk(format_version, least_version, vals, kept_extras, missing_groups))))
  | {word_value:wordx}{format_version,least_version:int}{kept_extras:extras}{lost_groups:lost}{missing_groups:absent}{vals:gvals}{octets:bytes}
    WORDDEC_loss(octets, wr_loss(word_value, format_version, least_version, kept_extras, lost_groups)) of (WORDV(word_value, vals), DECODES(WORD_SPECS, WORD_KIND, octets, rr_loss(rx_mk(format_version, least_version, vals, kept_extras, missing_groups), lost_groups)))
  | {octets:bytes} WORDDEC_notquire(octets, wr_notquire()) of DECODES(WORD_SPECS, WORD_KIND, octets, rr_notquire())
  | {octets:bytes} WORDDEC_newer(octets, wr_newer()) of DECODES(WORD_SPECS, WORD_KIND, octets, rr_newer())
  | {octets:bytes} WORDDEC_damaged(octets, wr_damaged()) of DECODES(WORD_SPECS, WORD_KIND, octets, rr_damaged())

(* WORDEQ(written_value, read_value): the words are one (keyword: vocabulary) *)
#pub dataprop WORDEQ(wordx, wordx) =
  | {word_value:wordx} WORDEQ_refl(word_value, word_value)

(* A word written and read back is the word written, in the same format (keyword: vocabulary) *)
#pub prfun word_roundtrip {written_value,read_value:wordx}{format_version,least_version,read_format_version,read_least_version:int}{kept_extras,read_extras:extras}{octets:bytes}{byte_count:nat}
  (LEN(octets, byte_count), WORDENC(written_value, format_version, least_version, kept_extras, octets), WORDDEC(octets, wr_ok(read_value, read_format_version, read_least_version, read_extras)))
  : (WORDEQ(written_value, read_value), EQI(format_version, read_format_version), EQI(least_version, read_least_version))

primplement word_roundtrip {written_value,read_value}{format_version,least_version,read_format_version,read_least_version}{kept_extras,read_extras}{octets}{byte_count} (whole, written, read) =
  case+ written of
  | WORDENC_mk(fields_written, encoded) =>
    (case+ read of
     | WORDDEC_ok(fields_read, decoded) => let
         prval EQRR_refl() = decodes_functional(whole, encodes_decodes(encoded), decoded)
         prval WORDV_mk() = fields_written
         prval WORDV_mk() = fields_read
       in (WORDEQ_refl(), EQI_refl(), EQI_refl()) end)

(* WORDRES(first, second): the results of reading are one (keyword: vocabulary) *)
#pub dataprop WORDRES(wordres, wordres) =
  | {outcome:wordres} WORDRES_refl(outcome, outcome)

(* Reading what a word was written as is reading that word (keyword: vocabulary) *)
#pub prfun word_enc_dec {word_value:wordx}{format_version,least_version:int}{kept_extras:extras}{octets:bytes}{byte_count:nat}{outcome:wordres}
  (LEN(octets, byte_count), WORDENC(word_value, format_version, least_version, kept_extras, octets), WORDDEC(octets, outcome)): WORDRES(outcome, wr_ok(word_value, format_version, least_version, kept_extras))

primplement word_enc_dec {word_value}{format_version,least_version}{kept_extras}{octets}{byte_count}{outcome} (whole, written, read) =
  case+ written of
  | WORDENC_mk(fields_written, encoded) =>
    (case+ read of
     | WORDDEC_ok(fields_read, decoded) => let
         prval EQRR_refl() = decodes_functional(whole, encodes_decodes(encoded), decoded)
         prval WORDV_mk() = fields_written
         prval WORDV_mk() = fields_read
       in WORDRES_refl() end
     | WORDDEC_loss(_, decoded) =>
       (case+ decodes_functional(whole, encodes_decodes(encoded), decoded) of EQRR_refl() =/=> ())
     | WORDDEC_notquire(decoded) =>
       (case+ decodes_functional(whole, encodes_decodes(encoded), decoded) of EQRR_refl() =/=> ())
     | WORDDEC_newer(decoded) =>
       (case+ decodes_functional(whole, encodes_decodes(encoded), decoded) of EQRR_refl() =/=> ())
     | WORDDEC_damaged(decoded) =>
       (case+ decodes_functional(whole, encodes_decodes(encoded), decoded) of EQRR_refl() =/=> ()))

(* a word record at run time: its format version, the least version that reads it, the word, and the chunks kept (keyword: vocabulary) *)
#pub datavtype wordrecord(wordx, int, int, extras) =
  | {word_value:wordx}{format_version,least_version:int | 0 <= format_version; format_version < 256; 0 <= least_version; least_version <= READER}{kept_extras:extras}{extra_count:nat}
    WordRecord(word_value, format_version, least_version, kept_extras) of (int format_version, int least_version, wordv(word_value), extrasv(WORD_SPECS, kept_extras, extra_count))

#pub datavtype wordread(wordres) =
  | {word_value:wordx}{format_version,least_version:int}{kept_extras:extras} WR_ok(wr_ok(word_value, format_version, least_version, kept_extras)) of wordrecord(word_value, format_version, least_version, kept_extras)
  | {word_value:wordx}{format_version,least_version:int}{kept_extras:extras}{lost_groups:lost}{lost_count:nat} WR_loss(wr_loss(word_value, format_version, least_version, kept_extras, lost_groups)) of (wordrecord(word_value, format_version, least_version, kept_extras), lostv(lost_groups, lost_count))
  | WR_notquire(wr_notquire())
  | WR_newer(wr_newer())
  | WR_damaged(wr_damaged())

#pub fun word_record_write {word_value:wordx}{format_version,least_version:int}{kept_extras:extras} (record: !wordrecord(word_value, format_version, least_version, kept_extras))
  : [octets:bytes][written_len:nat] (WORDENC(word_value, format_version, least_version, kept_extras, octets) | blist(octets, written_len))

implement word_record_write {word_value}{format_version,least_version}{kept_extras} (record) =
  case+ record of
  | WordRecord(format_version, least_version, word, extras) => let
      val specs = word_specs()
      val (fields | vals) = word_to_vals(word)
      val (written | record_bytes) = record_write(specs, 3, format_version, least_version, vals, extras)
      val () = gvalsv_free(vals)
      val () = specsv_free(specs)
    in (WORDENC_mk(fields, written) | record_bytes) end

#pub fun word_record_read {octets:bytes}{byte_count:nat} (list: blist(octets, byte_count)): [outcome:wordres] (WORDDEC(octets, outcome) | wordread(outcome))

implement word_record_read {octets}{byte_count} (list) = let
  val specs = word_specs()
  val (read | read_outcome) = record_read(specs, 3, list)
  val () = specsv_free(specs)
in
  case+ read_outcome of
  | ~RR_ok(format_version, least_version, vals, extras, missing) => let
      val (fields | word) = word_of_vals(vals)
      val () = absentv_free(missing)
    in (WORDDEC_ok(fields, read) | WR_ok(WordRecord(format_version, least_version, word, extras))) end
  | ~RR_loss(format_version, least_version, vals, extras, lost, missing) => let
      val (fields | word) = word_of_vals(vals)
      val () = absentv_free(missing)
    in (WORDDEC_loss(fields, read) | WR_loss(WordRecord(format_version, least_version, word, extras), lost)) end
  | ~RR_notquire() => (WORDDEC_notquire(read) | WR_notquire())
  | ~RR_newer() => (WORDDEC_newer(read) | WR_newer())
  | ~RR_damaged() => (WORDDEC_damaged(read) | WR_damaged())
end

(* A result of reading as another it is the same as (keyword: vocabulary) *)
#pub fun word_read_recast {first,second:wordres} (same: WORDRES(first, second) | read: wordread(first)): wordread(second)

implement word_read_recast {first,second} (same | read) = let
  prval WORDRES_refl() = same
in read end

(* A decoding as the decoding it is the same as (keyword: vocabulary) *)
#pub prfun word_dec_recast {octets:bytes}{first,second:wordres} (WORDRES(first, second), WORDDEC(octets, first)): WORDDEC(octets, second)

primplement word_dec_recast {octets}{first,second} (same, dec) = let
  prval WORDRES_refl() = same
in dec end

end
