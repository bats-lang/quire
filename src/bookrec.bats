#pub stadef BOOK_SPECS = gs_cons(bcons(65, bcons(85, bcons(84, bcons(72, bnil())))), lo_str(lo_nil()), m_req(), fv_str(bnil(), fv_nil()), gs_cons(bcons(66, bcons(79, bcons(79, bcons(75, bnil())))), lo_i32(lo_i32(lo_nil())), m_req(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(67, bcons(79, bcons(76, bcons(76, bnil())))), lo_i32(lo_i32(lo_nil())), m_opt(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(69, bcons(76, bcons(83, bcons(69, bnil())))), lo_i32(lo_i32(lo_nil())), m_opt(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(70, bcons(78, bcons(83, bcons(72, bnil())))), lo_i32(lo_i32(lo_nil())), m_opt(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(80, bcons(76, bcons(67, bcons(69, bnil())))), lo_i32(lo_i32(lo_i32(lo_i32(lo_i32(lo_i32(lo_i32(lo_nil()))))))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_i32(0, fv_i32(0, fv_i32(0, fv_i32(0, fv_nil()))))))), gs_cons(bcons(83, bcons(69, bcons(82, bcons(73, bnil())))), lo_str(lo_i32(lo_nil())), m_opt(), fv_str(bnil(), fv_i32(0, fv_nil())), gs_cons(bcons(83, bcons(72, bcons(76, bcons(70, bnil())))), lo_i32(lo_i32(lo_i32(lo_i32(lo_nil())))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_i32(0, fv_nil())))), gs_cons(bcons(83, bcons(73, bcons(90, bcons(69, bnil())))), lo_i32(lo_i32(lo_i32(lo_nil()))), m_opt(), fv_i32(0, fv_i32(0, fv_i32(0, fv_nil()))), gs_cons(bcons(84, bcons(73, bcons(77, bcons(69, bnil())))), lo_i32(lo_i32(lo_nil())), m_opt(), fv_i32(0, fv_i32(0, fv_nil())), gs_cons(bcons(84, bcons(73, bcons(84, bcons(76, bnil())))), lo_str(lo_nil()), m_req(), fv_str(bnil(), fv_nil()), gs_nil())))))))))))

