(* text_labels -- the labels that name an encoding, as the table the proofs of text_relation read.
   GENERATED by scripts/gen-encodings.py: do not edit. Keyword: text-encoding relation. *)

#target wasm begin

#include "share/atspre_staload.hats"

staload "bytes.sats"

(* The single-byte encodings Quire has a table for *)
#pub datasort codepage = Cp1250 of () | Cp1251 of () | Cp1252 of () | Cp1253 of () | Cp1254 of () | Cp1255 of () | Cp1256 of () | Cp1257 of () | Iso88592 of () | Iso88595 of () | Iso88597 of () | Iso88598 of () | Iso885915 of () | Koi8r of ()

(* The order of the bytes of a UTF-16 unit *)
#pub datasort byteorder = LittleEndian of () | BigEndian of ()

(* How a document's bytes are read: UTF-8, UTF-16 (either order), an encoding Quire has no table for, or one of the single-byte encodings *)
#pub datasort tsrc = SrcUtf8 of () | SrcUtf16 of (byteorder) | SrcUnsupported of () | SrcTable of (codepage)

(* EQSRC(first, second): two sources are one *)
#pub dataprop EQSRC(tsrc, tsrc) =
  | {same:tsrc} EQSRC_refl(same, same)

(* The number of labels (the entries 0 to LABEL_COUNT - 1) *)
#pub stadef LABEL_COUNT = 77

(* LABEL_COUNT, as a value *)
#pub fn text_label_total (): int(LABEL_COUNT)

implement text_label_total () = 77

