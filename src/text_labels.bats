(* An entry is one label and one source *)
#pub prfun entry_functional {index:nat}{first_label,second_label:bytes}{first_source,second_source:int}
  (ENTRY(index, first_label, first_source), ENTRY(index, second_label, second_source)): (EQB(first_label, second_label), EQI(first_source, second_source))

primplement entry_functional {index}{first_label,second_label}{first_source,second_source} (one, other) =
  case+ one of
  | ENTRY_0() => (case+ other of ENTRY_0() => (EQB_refl(), EQI_refl()))
