(* A byte stands for one code point in an encoding *)
#pub prfun tableat_functional {source:int}{byte:int}{first,second:int}
  (TABLEAT(source, byte, first), TABLEAT(source, byte, second)): [first == second] void

primplement tableat_functional {source}{byte}{first,second} (one, other) =
  case+ one of
