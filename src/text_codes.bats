(* The code point a byte of 128 to 255 stands for in a single-byte source, with the proof of it *)
#pub fn text_table_point {source:int | 4 <= source; source <= 17}{byte:int | 128 <= byte; byte < 256} (source: label_source(source), byte: int byte)
  : [point:int | 0 <= point; point < 65536] (TABLEAT(source, byte, point) | int point)

implement text_table_point {source}{byte} (source, byte) =
  case+ source of
  | LabelCp1250() => _table_cp1250(byte)
  | LabelCp1251() => _table_cp1251(byte)
  | LabelCp1252() => _table_cp1252(byte)
  | LabelCp1253() => _table_cp1253(byte)
  | LabelCp1254() => _table_cp1254(byte)
  | LabelCp1255() => _table_cp1255(byte)
  | LabelCp1256() => _table_cp1256(byte)
  | LabelCp1257() => _table_cp1257(byte)
  | LabelIso88592() => _table_iso88592(byte)
  | LabelIso88595() => _table_iso88595(byte)
  | LabelIso88597() => _table_iso88597(byte)
  | LabelIso88598() => _table_iso88598(byte)
  | LabelIso885915() => _table_iso885915(byte)
  | LabelKoi8r() => _table_koi8r(byte)

end
