(* wordimage -- a stored word as values, indexed by the word they hold: what differs between two, and a record patched with it.
   Generated by scripts/gen-image.py word *)

#target wasm begin

#include "share/atspre_staload.hats"

#use array as A
#use arith as AR

staload "bytes.sats"
staload "fields.sats"
staload "schema.sats"
staload "record.sats"
staload "bytesarr.sats"
staload "wordrec.sats"

(* A stored word as values: each number as its four bytes, each string in an array that holds it.
   The index says which word it is. *)
#pub datavtype word_image(wordx) =
  | {book_high:int}{book_low:int}{lookups:int}{first_minute:int}{last_minute:int}{language:bytes}{modified:int}{deleted:int}{chapter:int}{node:int}{offset:int}{sentence_head:bytes}{sentence_tail:bytes}{mastered:int}{streak:int}{due:int}{word:bytes}
    WordImage(wordx_mk(book_high, book_low, lookups, first_minute, last_minute, language, modified, deleted, chapter, node, offset, sentence_head, sentence_tail, mastered, streak, due, word)) of (int32v(book_high), int32v(book_low), int32v(lookups), int32v(first_minute), int32v(last_minute), bstr(language), int32v(modified), int32v(deleted), int32v(chapter), int32v(node), int32v(offset), bstr(sentence_head), bstr(sentence_tail), int32v(mastered), int32v(streak), int32v(due), bstr(word))

(* The image of a word, or none: a string too long for an array *)
#pub datavtype word_imaged(wordx) =
  | {word_value:wordx} WordImaged(word_value) of word_image(word_value)
  | {word_value:wordx} WordNotImaged(word_value) of ()

(* The numbers of a stored word, by name *)
#pub typedef word_numbers = @{book_high = Int, book_low = Int, lookups = Int, first_minute = Int, last_minute = Int, modified = Int, deleted = Int, chapter = Int, node = Int, offset = Int, mastered = Int, streak = Int, due = Int}

#pub fun word_image_free {word_value:wordx} (image: word_image(word_value)): void

implement word_image_free {word_value} (image) =
  case+ image of
  | ~WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => let
      val () = int32_free(image_book_high)
      val () = int32_free(image_book_low)
      val () = int32_free(image_lookups)
      val () = int32_free(image_first_minute)
      val () = int32_free(image_last_minute)
      val () = bstr_free(image_language)
      val () = int32_free(image_modified)
      val () = int32_free(image_deleted)
      val () = int32_free(image_chapter)
      val () = int32_free(image_node)
      val () = int32_free(image_offset)
      val () = bstr_free(image_sentence_head)
      val () = bstr_free(image_sentence_tail)
      val () = int32_free(image_mastered)
      val () = int32_free(image_streak)
      val () = int32_free(image_due)
      val () = bstr_free(image_word)
    in () end

#pub fun word_image_copy {word_value:wordx} (image: !word_image(word_value)): word_image(word_value)

implement word_image_copy {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => let
      val copy_book_high = int32_copy(image_book_high)
      val copy_book_low = int32_copy(image_book_low)
      val copy_lookups = int32_copy(image_lookups)
      val copy_first_minute = int32_copy(image_first_minute)
      val copy_last_minute = int32_copy(image_last_minute)
      val copy_language = bstr_copy(image_language)
      val copy_modified = int32_copy(image_modified)
      val copy_deleted = int32_copy(image_deleted)
      val copy_chapter = int32_copy(image_chapter)
      val copy_node = int32_copy(image_node)
      val copy_offset = int32_copy(image_offset)
      val copy_sentence_head = bstr_copy(image_sentence_head)
      val copy_sentence_tail = bstr_copy(image_sentence_tail)
      val copy_mastered = int32_copy(image_mastered)
      val copy_streak = int32_copy(image_streak)
      val copy_due = int32_copy(image_due)
      val copy_word = bstr_copy(image_word)
    in WordImage(copy_book_high, copy_book_low, copy_lookups, copy_first_minute, copy_last_minute, copy_language, copy_modified, copy_deleted, copy_chapter, copy_node, copy_offset, copy_sentence_head, copy_sentence_tail, copy_mastered, copy_streak, copy_due, copy_word) end

(* The numbers of an image *)
#pub fun word_image_numbers {word_value:wordx} (image: !word_image(word_value)): word_numbers

implement word_image_numbers {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => @{book_high = int32_value(image_book_high), book_low = int32_value(image_book_low), lookups = int32_value(image_lookups), first_minute = int32_value(image_first_minute), last_minute = int32_value(image_last_minute), modified = int32_value(image_modified), deleted = int32_value(image_deleted), chapter = int32_value(image_chapter), node = int32_value(image_node), offset = int32_value(image_offset), mastered = int32_value(image_mastered), streak = int32_value(image_streak), due = int32_value(image_due)}

(* A string of an image: its length, and a copy of its bytes in an array one longer *)
#pub fun word_image_language {word_value:wordx} (image: !word_image(word_value)): [text_loc:agz][text_len:nat | text_len < 256] @($A.arr(byte, text_loc, text_len + 1), int text_len)

implement word_image_language {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => array_of_bstr(image_language)

#pub fun word_image_sentence_head {word_value:wordx} (image: !word_image(word_value)): [text_loc:agz][text_len:nat | text_len < 256] @($A.arr(byte, text_loc, text_len + 1), int text_len)

implement word_image_sentence_head {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => array_of_bstr(image_sentence_head)

#pub fun word_image_sentence_tail {word_value:wordx} (image: !word_image(word_value)): [text_loc:agz][text_len:nat | text_len < 256] @($A.arr(byte, text_loc, text_len + 1), int text_len)

implement word_image_sentence_tail {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => array_of_bstr(image_sentence_tail)

#pub fun word_image_word {word_value:wordx} (image: !word_image(word_value)): [text_loc:agz][text_len:nat | text_len < 256] @($A.arr(byte, text_loc, text_len + 1), int text_len)

implement word_image_word {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => array_of_bstr(image_word)

(* the bit of the group BOOK in a mask of groups *)
#pub fn word_group_book (): int

implement word_group_book () = 1

(* the bit of the group COUN in a mask of groups *)
#pub fn word_group_coun (): int

implement word_group_coun () = 2

(* the bit of the group LANG in a mask of groups *)
#pub fn word_group_lang (): int

implement word_group_lang () = 4

(* the bit of the group MODF in a mask of groups *)
#pub fn word_group_modf (): int

implement word_group_modf () = 8

(* the bit of the group PLCE in a mask of groups *)
#pub fn word_group_plce (): int

implement word_group_plce () = 16

(* the bit of the group SENT in a mask of groups *)
#pub fn word_group_sent (): int

implement word_group_sent () = 32

(* the bit of the group STAT in a mask of groups *)
#pub fn word_group_stat (): int

implement word_group_stat () = 64

(* the bit of the group WORD in a mask of groups *)
#pub fn word_group_word (): int

implement word_group_word () = 128

(* every group *)
#pub fn word_group_all (): int

implement word_group_all () = 255

(* The numbers of kept in the groups of keep_mask, and the others' of other *)
#pub fun word_numbers_merge (kept: word_numbers, other: word_numbers, keep_mask: int): word_numbers

implement word_numbers_merge (kept, other, keep_mask) = @{book_high = (if $AR.band_int_int(keep_mask, 1) <> 0 then kept.book_high else other.book_high), book_low = (if $AR.band_int_int(keep_mask, 1) <> 0 then kept.book_low else other.book_low), lookups = (if $AR.band_int_int(keep_mask, 2) <> 0 then kept.lookups else other.lookups), first_minute = (if $AR.band_int_int(keep_mask, 2) <> 0 then kept.first_minute else other.first_minute), last_minute = (if $AR.band_int_int(keep_mask, 2) <> 0 then kept.last_minute else other.last_minute), modified = (if $AR.band_int_int(keep_mask, 8) <> 0 then kept.modified else other.modified), deleted = (if $AR.band_int_int(keep_mask, 8) <> 0 then kept.deleted else other.deleted), chapter = (if $AR.band_int_int(keep_mask, 16) <> 0 then kept.chapter else other.chapter), node = (if $AR.band_int_int(keep_mask, 16) <> 0 then kept.node else other.node), offset = (if $AR.band_int_int(keep_mask, 16) <> 0 then kept.offset else other.offset), mastered = (if $AR.band_int_int(keep_mask, 64) <> 0 then kept.mastered else other.mastered), streak = (if $AR.band_int_int(keep_mask, 64) <> 0 then kept.streak else other.streak), due = (if $AR.band_int_int(keep_mask, 64) <> 0 then kept.due else other.due)}

(* The groups whose fields differ in two images, as a mask *)
#pub fun word_image_diff {first_value,second_value:wordx} (first: !word_image(first_value), second: !word_image(second_value)): int

implement word_image_diff {first_value,second_value} (first, second) =
  case+ first of
  | WordImage(first_book_high, first_book_low, first_lookups, first_first_minute, first_last_minute, first_language, first_modified, first_deleted, first_chapter, first_node, first_offset, first_sentence_head, first_sentence_tail, first_mastered, first_streak, first_due, first_word) =>
    (case+ second of
     | WordImage(second_book_high, second_book_low, second_lookups, second_first_minute, second_last_minute, second_language, second_modified, second_deleted, second_chapter, second_node, second_offset, second_sentence_head, second_sentence_tail, second_mastered, second_streak, second_due, second_word) => let
         val differs_book = (if (int32_value(first_book_high) <> int32_value(second_book_high)) || (int32_value(first_book_low) <> int32_value(second_book_low)) then 1 else 0): int
         val differs_coun = (if (int32_value(first_lookups) <> int32_value(second_lookups)) || (int32_value(first_first_minute) <> int32_value(second_first_minute)) || (int32_value(first_last_minute) <> int32_value(second_last_minute)) then 2 else 0): int
         val differs_lang = (if (~bstr_equal(first_language, second_language)) then 4 else 0): int
         val differs_modf = (if (int32_value(first_modified) <> int32_value(second_modified)) || (int32_value(first_deleted) <> int32_value(second_deleted)) then 8 else 0): int
         val differs_plce = (if (int32_value(first_chapter) <> int32_value(second_chapter)) || (int32_value(first_node) <> int32_value(second_node)) || (int32_value(first_offset) <> int32_value(second_offset)) then 16 else 0): int
         val differs_sent = (if (~bstr_equal(first_sentence_head, second_sentence_head)) || (~bstr_equal(first_sentence_tail, second_sentence_tail)) then 32 else 0): int
         val differs_stat = (if (int32_value(first_mastered) <> int32_value(second_mastered)) || (int32_value(first_streak) <> int32_value(second_streak)) || (int32_value(first_due) <> int32_value(second_due)) then 64 else 0): int
         val differs_word = (if (~bstr_equal(first_word, second_word)) then 128 else 0): int
       in $AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int(0, differs_book), differs_coun), differs_lang), differs_modf), differs_plce), differs_sent), differs_stat), differs_word) end)

(* The image of a word: the very word *)
#pub fun word_image_of {word_value:wordx} (word: !wordv(word_value)): word_image(word_value)

implement word_image_of {word_value} (word) =
  case+ word of
  | WordV(field_book_high, field_book_low, field_lookups, field_first_minute, field_last_minute, field_language, field_modified, field_deleted, field_chapter, field_node, field_offset, field_sentence_head, field_sentence_tail, field_mastered, field_streak, field_due, field_word) => let
      val number_book_high = int32_copy(field_book_high)
      val number_book_low = int32_copy(field_book_low)
      val number_lookups = int32_copy(field_lookups)
      val number_first_minute = int32_copy(field_first_minute)
      val number_last_minute = int32_copy(field_last_minute)
      val text_language = bstr_of_blist(field_language)
      val number_modified = int32_copy(field_modified)
      val number_deleted = int32_copy(field_deleted)
      val number_chapter = int32_copy(field_chapter)
      val number_node = int32_copy(field_node)
      val number_offset = int32_copy(field_offset)
      val text_sentence_head = bstr_of_blist(field_sentence_head)
      val text_sentence_tail = bstr_of_blist(field_sentence_tail)
      val number_mastered = int32_copy(field_mastered)
      val number_streak = int32_copy(field_streak)
      val number_due = int32_copy(field_due)
      val text_word = bstr_of_blist(field_word)
    in WordImage(number_book_high, number_book_low, number_lookups, number_first_minute, number_last_minute, text_language, number_modified, number_deleted, number_chapter, number_node, number_offset, text_sentence_head, text_sentence_tail, number_mastered, number_streak, number_due, text_word) end

(* The word an image holds *)
#pub fun word_of_image {word_value:wordx} (image: !word_image(word_value)): wordv(word_value)

implement word_of_image {word_value} (image) =
  case+ image of
  | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => let
      val number_book_high = int32_copy(image_book_high)
      val number_book_low = int32_copy(image_book_low)
      val number_lookups = int32_copy(image_lookups)
      val number_first_minute = int32_copy(image_first_minute)
      val number_last_minute = int32_copy(image_last_minute)
      val list_language = blist_of_bstr(image_language)
      val number_modified = int32_copy(image_modified)
      val number_deleted = int32_copy(image_deleted)
      val number_chapter = int32_copy(image_chapter)
      val number_node = int32_copy(image_node)
      val number_offset = int32_copy(image_offset)
      val list_sentence_head = blist_of_bstr(image_sentence_head)
      val list_sentence_tail = blist_of_bstr(image_sentence_tail)
      val number_mastered = int32_copy(image_mastered)
      val number_streak = int32_copy(image_streak)
      val number_due = int32_copy(image_due)
      val list_word = blist_of_bstr(image_word)
    in WordV(number_book_high, number_book_low, number_lookups, number_first_minute, number_last_minute, list_language, number_modified, number_deleted, number_chapter, number_node, number_offset, list_sentence_head, list_sentence_tail, number_mastered, number_streak, number_due, list_word) end

(* The image of a stored word, as read *)
#pub fun word_record_image {word_value:wordx}{format_version,least_version:int}{kept_extras:extras} (record: !wordrecord(word_value, format_version, least_version, kept_extras)): word_image(word_value)

implement word_record_image {word_value}{format_version,least_version}{kept_extras} (record) =
  case+ record of WordRecord(_, _, word, _) => word_image_of(word)

(* A new record of an image: the format version this Quire writes, and no chunks kept. It holds the very word the image does. *)
#pub fun word_record_new {word_value:wordx} (image: !word_image(word_value)): wordrecord(word_value, 1, 1, ex_nil())

implement word_record_new {word_value} (image) = WordRecord(1, 1, word_of_image(image), EXV_nil())

fn word_free_book {word_value:wordx} (word: wordv(word_value)): void =
  case+ word of
  | ~WordV(field_book_high, field_book_low, field_lookups, field_first_minute, field_last_minute, field_language, field_modified, field_deleted, field_chapter, field_node, field_offset, field_sentence_head, field_sentence_tail, field_mastered, field_streak, field_due, field_word) => let
      val () = int32_free(field_book_high)
      val () = int32_free(field_book_low)
      val () = int32_free(field_lookups)
      val () = int32_free(field_first_minute)
      val () = int32_free(field_last_minute)
      val () = blist_free(field_language)
      val () = int32_free(field_modified)
      val () = int32_free(field_deleted)
      val () = int32_free(field_chapter)
      val () = int32_free(field_node)
      val () = int32_free(field_offset)
      val () = blist_free(field_sentence_head)
      val () = blist_free(field_sentence_tail)
      val () = int32_free(field_mastered)
      val () = int32_free(field_streak)
      val () = int32_free(field_due)
      val () = blist_free(field_word)
    in () end

(* A record freed *)
#pub fun word_record_free {word_value:wordx}{format_version,least_version:int}{kept_extras:extras} (record: wordrecord(word_value, format_version, least_version, kept_extras)): void

implement word_record_free {word_value}{format_version,least_version}{kept_extras} (record) =
  case+ record of
  | ~WordRecord(_, _, word, extras) => let
      val () = word_free_book(word)
    in extrasv_free(extras) end

(* The number of the record, or the image's *)
fn _pick_number {kept_number,other_number:int} (take: bool, kept: int32v(kept_number), other: !int32v(other_number)): [picked_number:int] int32v(picked_number) =
  if take then let val () = int32_free(kept) in int32_copy(other) end else kept

(* The bytes of the record, or those the image's array holds *)
fn _pick_text {kept_octets,other_octets:bytes}{kept_len:nat | kept_len < 256} (take: bool, kept: blist(kept_octets, kept_len), other: !bstr(other_octets)): [picked_octets:bytes][picked_len:nat | picked_len < 256] blist(picked_octets, picked_len) =
  if take then let val () = blist_free(kept) in blist_of_bstr(other) end else kept

(* The record with the groups in the mask taken from the image, and the others as they are *)
#pub fun word_record_patch {record_value,image_value:wordx}{format_version,least_version:int}{kept_extras:extras} (record: wordrecord(record_value, format_version, least_version, kept_extras), image: !word_image(image_value), mask: int)
  : [patched_value:wordx] wordrecord(patched_value, format_version, least_version, kept_extras)

implement word_record_patch {record_value,image_value}{format_version,least_version}{kept_extras} (record, image, mask) =
  case+ record of
  | ~WordRecord(format_version, least_version, word, extras) =>
    (case+ word of
     | ~WordV(field_book_high, field_book_low, field_lookups, field_first_minute, field_last_minute, field_language, field_modified, field_deleted, field_chapter, field_node, field_offset, field_sentence_head, field_sentence_tail, field_mastered, field_streak, field_due, field_word) =>
       (case+ image of
        | WordImage(image_book_high, image_book_low, image_lookups, image_first_minute, image_last_minute, image_language, image_modified, image_deleted, image_chapter, image_node, image_offset, image_sentence_head, image_sentence_tail, image_mastered, image_streak, image_due, image_word) => let
            val take_book = $AR.band_int_int(mask, 1) <> 0
            val take_coun = $AR.band_int_int(mask, 2) <> 0
            val take_lang = $AR.band_int_int(mask, 4) <> 0
            val take_modf = $AR.band_int_int(mask, 8) <> 0
            val take_plce = $AR.band_int_int(mask, 16) <> 0
            val take_sent = $AR.band_int_int(mask, 32) <> 0
            val take_stat = $AR.band_int_int(mask, 64) <> 0
            val take_word = $AR.band_int_int(mask, 128) <> 0
            val chosen_book_high = _pick_number(take_book, field_book_high, image_book_high)
            val chosen_book_low = _pick_number(take_book, field_book_low, image_book_low)
            val chosen_lookups = _pick_number(take_coun, field_lookups, image_lookups)
            val chosen_first_minute = _pick_number(take_coun, field_first_minute, image_first_minute)
            val chosen_last_minute = _pick_number(take_coun, field_last_minute, image_last_minute)
            val chosen_language = _pick_text(take_lang, field_language, image_language)
            val chosen_modified = _pick_number(take_modf, field_modified, image_modified)
            val chosen_deleted = _pick_number(take_modf, field_deleted, image_deleted)
            val chosen_chapter = _pick_number(take_plce, field_chapter, image_chapter)
            val chosen_node = _pick_number(take_plce, field_node, image_node)
            val chosen_offset = _pick_number(take_plce, field_offset, image_offset)
            val chosen_sentence_head = _pick_text(take_sent, field_sentence_head, image_sentence_head)
            val chosen_sentence_tail = _pick_text(take_sent, field_sentence_tail, image_sentence_tail)
            val chosen_mastered = _pick_number(take_stat, field_mastered, image_mastered)
            val chosen_streak = _pick_number(take_stat, field_streak, image_streak)
            val chosen_due = _pick_number(take_stat, field_due, image_due)
            val chosen_word = _pick_text(take_word, field_word, image_word)
          in WordRecord(format_version, least_version, WordV(chosen_book_high, chosen_book_low, chosen_lookups, chosen_first_minute, chosen_last_minute, chosen_language, chosen_modified, chosen_deleted, chosen_chapter, chosen_node, chosen_offset, chosen_sentence_head, chosen_sentence_tail, chosen_mastered, chosen_streak, chosen_due, chosen_word), extras) end))

(* An image of numbers and strings (each in an array one longer than the string, which it takes), or none when a number is not one of 32 bits *)
#pub fun word_image_make {language_loc,sentence_head_loc,sentence_tail_loc,word_loc:agz}{language_len,sentence_head_len,sentence_tail_len,word_len:nat | language_len < 256; sentence_head_len < 256; sentence_tail_len < 256; word_len < 256}
  (numbers: word_numbers, language: $A.arr(byte, language_loc, language_len + 1), language_len: int language_len, sentence_head: $A.arr(byte, sentence_head_loc, sentence_head_len + 1), sentence_head_len: int sentence_head_len, sentence_tail: $A.arr(byte, sentence_tail_loc, sentence_tail_len + 1), sentence_tail_len: int sentence_tail_len, word: $A.arr(byte, word_loc, word_len + 1), word_len: int word_len): [word_value:wordx] word_imaged(word_value)

implement word_image_make (numbers, language, language_len, sentence_head, sentence_head_len, sentence_tail, sentence_tail_len, word, word_len) = let
in
  case+ int32_make(numbers.book_high) of
  | ~I32_unrepresentable() => let
      val () = $A.free<byte>(language)
      val () = $A.free<byte>(sentence_head)
      val () = $A.free<byte>(sentence_tail)
      val () = $A.free<byte>(word)
    in WordNotImaged() end
  | ~I32_made(number_book_high) =>
    case+ int32_make(numbers.book_low) of
    | ~I32_unrepresentable() => let
        val () = int32_free(number_book_high)
        val () = $A.free<byte>(language)
        val () = $A.free<byte>(sentence_head)
        val () = $A.free<byte>(sentence_tail)
        val () = $A.free<byte>(word)
      in WordNotImaged() end
    | ~I32_made(number_book_low) =>
      case+ int32_make(numbers.lookups) of
      | ~I32_unrepresentable() => let
          val () = int32_free(number_book_high)
          val () = int32_free(number_book_low)
          val () = $A.free<byte>(language)
          val () = $A.free<byte>(sentence_head)
          val () = $A.free<byte>(sentence_tail)
          val () = $A.free<byte>(word)
        in WordNotImaged() end
      | ~I32_made(number_lookups) =>
        case+ int32_make(numbers.first_minute) of
        | ~I32_unrepresentable() => let
            val () = int32_free(number_book_high)
            val () = int32_free(number_book_low)
            val () = int32_free(number_lookups)
            val () = $A.free<byte>(language)
            val () = $A.free<byte>(sentence_head)
            val () = $A.free<byte>(sentence_tail)
            val () = $A.free<byte>(word)
          in WordNotImaged() end
        | ~I32_made(number_first_minute) =>
          case+ int32_make(numbers.last_minute) of
          | ~I32_unrepresentable() => let
              val () = int32_free(number_book_high)
              val () = int32_free(number_book_low)
              val () = int32_free(number_lookups)
              val () = int32_free(number_first_minute)
              val () = $A.free<byte>(language)
              val () = $A.free<byte>(sentence_head)
              val () = $A.free<byte>(sentence_tail)
              val () = $A.free<byte>(word)
            in WordNotImaged() end
          | ~I32_made(number_last_minute) =>
            case+ int32_make(numbers.modified) of
            | ~I32_unrepresentable() => let
                val () = int32_free(number_book_high)
                val () = int32_free(number_book_low)
                val () = int32_free(number_lookups)
                val () = int32_free(number_first_minute)
                val () = int32_free(number_last_minute)
                val () = $A.free<byte>(language)
                val () = $A.free<byte>(sentence_head)
                val () = $A.free<byte>(sentence_tail)
                val () = $A.free<byte>(word)
              in WordNotImaged() end
            | ~I32_made(number_modified) =>
              case+ int32_make(numbers.deleted) of
              | ~I32_unrepresentable() => let
                  val () = int32_free(number_book_high)
                  val () = int32_free(number_book_low)
                  val () = int32_free(number_lookups)
                  val () = int32_free(number_first_minute)
                  val () = int32_free(number_last_minute)
                  val () = int32_free(number_modified)
                  val () = $A.free<byte>(language)
                  val () = $A.free<byte>(sentence_head)
                  val () = $A.free<byte>(sentence_tail)
                  val () = $A.free<byte>(word)
                in WordNotImaged() end
              | ~I32_made(number_deleted) =>
                case+ int32_make(numbers.chapter) of
                | ~I32_unrepresentable() => let
                    val () = int32_free(number_book_high)
                    val () = int32_free(number_book_low)
                    val () = int32_free(number_lookups)
                    val () = int32_free(number_first_minute)
                    val () = int32_free(number_last_minute)
                    val () = int32_free(number_modified)
                    val () = int32_free(number_deleted)
                    val () = $A.free<byte>(language)
                    val () = $A.free<byte>(sentence_head)
                    val () = $A.free<byte>(sentence_tail)
                    val () = $A.free<byte>(word)
                  in WordNotImaged() end
                | ~I32_made(number_chapter) =>
                  case+ int32_make(numbers.node) of
                  | ~I32_unrepresentable() => let
                      val () = int32_free(number_book_high)
                      val () = int32_free(number_book_low)
                      val () = int32_free(number_lookups)
                      val () = int32_free(number_first_minute)
                      val () = int32_free(number_last_minute)
                      val () = int32_free(number_modified)
                      val () = int32_free(number_deleted)
                      val () = int32_free(number_chapter)
                      val () = $A.free<byte>(language)
                      val () = $A.free<byte>(sentence_head)
                      val () = $A.free<byte>(sentence_tail)
                      val () = $A.free<byte>(word)
                    in WordNotImaged() end
                  | ~I32_made(number_node) =>
                    case+ int32_make(numbers.offset) of
                    | ~I32_unrepresentable() => let
                        val () = int32_free(number_book_high)
                        val () = int32_free(number_book_low)
                        val () = int32_free(number_lookups)
                        val () = int32_free(number_first_minute)
                        val () = int32_free(number_last_minute)
                        val () = int32_free(number_modified)
                        val () = int32_free(number_deleted)
                        val () = int32_free(number_chapter)
                        val () = int32_free(number_node)
                        val () = $A.free<byte>(language)
                        val () = $A.free<byte>(sentence_head)
                        val () = $A.free<byte>(sentence_tail)
                        val () = $A.free<byte>(word)
                      in WordNotImaged() end
                    | ~I32_made(number_offset) =>
                      case+ int32_make(numbers.mastered) of
                      | ~I32_unrepresentable() => let
                          val () = int32_free(number_book_high)
                          val () = int32_free(number_book_low)
                          val () = int32_free(number_lookups)
                          val () = int32_free(number_first_minute)
                          val () = int32_free(number_last_minute)
                          val () = int32_free(number_modified)
                          val () = int32_free(number_deleted)
                          val () = int32_free(number_chapter)
                          val () = int32_free(number_node)
                          val () = int32_free(number_offset)
                          val () = $A.free<byte>(language)
                          val () = $A.free<byte>(sentence_head)
                          val () = $A.free<byte>(sentence_tail)
                          val () = $A.free<byte>(word)
                        in WordNotImaged() end
                      | ~I32_made(number_mastered) =>
                        case+ int32_make(numbers.streak) of
                        | ~I32_unrepresentable() => let
                            val () = int32_free(number_book_high)
                            val () = int32_free(number_book_low)
                            val () = int32_free(number_lookups)
                            val () = int32_free(number_first_minute)
                            val () = int32_free(number_last_minute)
                            val () = int32_free(number_modified)
                            val () = int32_free(number_deleted)
                            val () = int32_free(number_chapter)
                            val () = int32_free(number_node)
                            val () = int32_free(number_offset)
                            val () = int32_free(number_mastered)
                            val () = $A.free<byte>(language)
                            val () = $A.free<byte>(sentence_head)
                            val () = $A.free<byte>(sentence_tail)
                            val () = $A.free<byte>(word)
                          in WordNotImaged() end
                        | ~I32_made(number_streak) =>
                          case+ int32_make(numbers.due) of
                          | ~I32_unrepresentable() => let
                              val () = int32_free(number_book_high)
                              val () = int32_free(number_book_low)
                              val () = int32_free(number_lookups)
                              val () = int32_free(number_first_minute)
                              val () = int32_free(number_last_minute)
                              val () = int32_free(number_modified)
                              val () = int32_free(number_deleted)
                              val () = int32_free(number_chapter)
                              val () = int32_free(number_node)
                              val () = int32_free(number_offset)
                              val () = int32_free(number_mastered)
                              val () = int32_free(number_streak)
                              val () = $A.free<byte>(language)
                              val () = $A.free<byte>(sentence_head)
                              val () = $A.free<byte>(sentence_tail)
                              val () = $A.free<byte>(word)
                            in WordNotImaged() end
                          | ~I32_made(number_due) =>
                            let
                              val text_language = bstr_of_array(language, language_len)
                              val () = $A.free<byte>(language)
                              val text_sentence_head = bstr_of_array(sentence_head, sentence_head_len)
                              val () = $A.free<byte>(sentence_head)
                              val text_sentence_tail = bstr_of_array(sentence_tail, sentence_tail_len)
                              val () = $A.free<byte>(sentence_tail)
                              val text_word = bstr_of_array(word, word_len)
                              val () = $A.free<byte>(word)
                            in WordImaged(WordImage(number_book_high, number_book_low, number_lookups, number_first_minute, number_last_minute, text_language, number_modified, number_deleted, number_chapter, number_node, number_offset, text_sentence_head, text_sentence_tail, number_mastered, number_streak, number_due, text_word)) end
end

(* An image written as a record and read back: an image of the very word. That the bytes read are
   those written is the checked part (a word written is read back, whatever bytes they are);
   the image comes out of the record read, not out of the one written. *)
#pub fun word_image_roundtrip {word_value:wordx} (image: !word_image(word_value)): word_image(word_value)

implement word_image_roundtrip {word_value} (image) = let
  val record = word_record_new(image)
  val (written | list) = word_record_write(record)
  val () = word_record_free(record)
  val (whole | byte_count) = blist_len(list)
  val (read_proof | read) = word_record_read(list)
  prval same = word_enc_dec(whole, written, read_proof)
  val checked = word_read_recast(same | read)
in
  case+ checked of
  | ~WR_ok(record_read) => let
      val back = word_record_image(record_read)
      val () = word_record_free(record_read)
    in back end
end

end
