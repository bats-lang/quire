(* The image of a stored book, as read *)
#pub fun book_record_image {x:bookx}{ver,minver:int}{e:extras} (record: !bookrecord(x, ver, minver, e)): book_image

implement book_record_image {x}{ver,minver}{e} (record) =
  case+ record of BookRecord(_, _, book, _) => book_image_of(book)

(* A new record of an image: the format version this Quire writes, and no chunks kept *)
#pub fun book_record_new (image: !book_image): [x:bookx] bookrecord(x, 1, 1, ex_nil())

implement book_record_new (image) = BookRecord(1, 1, book_of_image(image), EXV_nil())

fn book_free_book {x:bookx} (book: bookv(x)): void =
  case+ book of
  | ~BookV(f_author, f_id_high, f_id_low, f_collections, f_collections_modified, f_minutes_elsewhere, f_pages_elsewhere, f_finished_at, f_finished_modified, f_chapter, f_chapters, f_page, f_pages, f_anchor, f_place_modified, f_place_declined, f_series, f_series_number, f_shelf, f_added, f_opened, f_shelf_modified, f_file_size, f_cover, f_done, f_minutes_read, f_pages_read, f_title) => let
      val () = blist_free(f_author)
      val () = int32_free(f_id_high)
      val () = int32_free(f_id_low)
      val () = int32_free(f_collections)
      val () = int32_free(f_collections_modified)
      val () = int32_free(f_minutes_elsewhere)
      val () = int32_free(f_pages_elsewhere)
      val () = int32_free(f_finished_at)
      val () = int32_free(f_finished_modified)
      val () = int32_free(f_chapter)
      val () = int32_free(f_chapters)
      val () = int32_free(f_page)
      val () = int32_free(f_pages)
      val () = int32_free(f_anchor)
      val () = int32_free(f_place_modified)
      val () = int32_free(f_place_declined)
      val () = blist_free(f_series)
      val () = int32_free(f_series_number)
      val () = int32_free(f_shelf)
      val () = int32_free(f_added)
      val () = int32_free(f_opened)
      val () = int32_free(f_shelf_modified)
      val () = int32_free(f_file_size)
      val () = int32_free(f_cover)
      val () = int32_free(f_done)
      val () = int32_free(f_minutes_read)
      val () = int32_free(f_pages_read)
      val () = blist_free(f_title)
    in () end

(* A record freed *)
#pub fun book_record_free {x:bookx}{ver,minver:int}{e:extras} (record: bookrecord(x, ver, minver, e)): void

implement book_record_free {x}{ver,minver}{e} (record) =
  case+ record of
  | ~BookRecord(_, _, book, extras) => let
      val () = book_free_book(book)
    in extrasv_free(extras) end

fn _choose {l1,l2:agz}{n,m:nat | n < 256; m < 256}
  (take: bool, base: $A.arr(byte, l1, n + 1), base_len: int n, update: !$A.arr(byte, l2, m + 1), update_len: int m)
  : [l:agz][k:nat | k < 256] @($A.arr(byte, l, k + 1), int k) =
  if take then let
    val () = $A.free<byte>(base)
    val copy = _copy_array(update, update_len)
  in @(copy, update_len) end
  else @(base, base_len)

(* The record with the groups in the mask taken from the image, and the others as they are *)
#pub fun book_record_patch {x:bookx}{ver,minver:int}{e:extras} (record: bookrecord(x, ver, minver, e), image: !book_image, mask: int)
  : [y:bookx] bookrecord(y, ver, minver, e)

implement book_record_patch {x}{ver,minver}{e} (record, image, mask) =
  case+ record of
  | ~BookRecord(ver, minver, book, extras) => let
      val previous = book_image_of(book)
      val () = book_free_book(book)
    in
      case+ previous of
      | ~BookImage(a_author, a_author_len, a_id_high, a_id_low, a_collections, a_collections_modified, a_minutes_elsewhere, a_pages_elsewhere, a_finished_at, a_finished_modified, a_chapter, a_chapters, a_page, a_pages, a_anchor, a_place_modified, a_place_declined, a_series, a_series_len, a_series_number, a_shelf, a_added, a_opened, a_shelf_modified, a_file_size, a_cover, a_done, a_minutes_read, a_pages_read, a_title, a_title_len) =>
        (case+ image of
         | BookImage(b_author, b_author_len, b_id_high, b_id_low, b_collections, b_collections_modified, b_minutes_elsewhere, b_pages_elsewhere, b_finished_at, b_finished_modified, b_chapter, b_chapters, b_page, b_pages, b_anchor, b_place_modified, b_place_declined, b_series, b_series_len, b_series_number, b_shelf, b_added, b_opened, b_shelf_modified, b_file_size, b_cover, b_done, b_minutes_read, b_pages_read, b_title, b_title_len) => let
             val take_auth = $AR.band_int_int(mask, 1) <> 0
             val take_book = $AR.band_int_int(mask, 2) <> 0
             val take_coll = $AR.band_int_int(mask, 4) <> 0
             val take_else = $AR.band_int_int(mask, 8) <> 0
             val take_fnsh = $AR.band_int_int(mask, 16) <> 0
             val take_plce = $AR.band_int_int(mask, 32) <> 0
             val take_seri = $AR.band_int_int(mask, 64) <> 0
             val take_shlf = $AR.band_int_int(mask, 128) <> 0
             val take_size = $AR.band_int_int(mask, 256) <> 0
             val take_time = $AR.band_int_int(mask, 512) <> 0
             val take_titl = $AR.band_int_int(mask, 1024) <> 0
             val @(c_author, c_author_len) = _choose(take_auth, a_author, a_author_len, b_author, b_author_len)
             val c_id_high = (if take_book then b_id_high else a_id_high): Int
             val c_id_low = (if take_book then b_id_low else a_id_low): Int
             val c_collections = (if take_coll then b_collections else a_collections): Int
             val c_collections_modified = (if take_coll then b_collections_modified else a_collections_modified): Int
             val c_minutes_elsewhere = (if take_else then b_minutes_elsewhere else a_minutes_elsewhere): Int
             val c_pages_elsewhere = (if take_else then b_pages_elsewhere else a_pages_elsewhere): Int
             val c_finished_at = (if take_fnsh then b_finished_at else a_finished_at): Int
             val c_finished_modified = (if take_fnsh then b_finished_modified else a_finished_modified): Int
             val c_chapter = (if take_plce then b_chapter else a_chapter): Int
             val c_chapters = (if take_plce then b_chapters else a_chapters): Int
             val c_page = (if take_plce then b_page else a_page): Int
             val c_pages = (if take_plce then b_pages else a_pages): Int
             val c_anchor = (if take_plce then b_anchor else a_anchor): Int
             val c_place_modified = (if take_plce then b_place_modified else a_place_modified): Int
             val c_place_declined = (if take_plce then b_place_declined else a_place_declined): Int
             val @(c_series, c_series_len) = _choose(take_seri, a_series, a_series_len, b_series, b_series_len)
             val c_series_number = (if take_seri then b_series_number else a_series_number): Int
             val c_shelf = (if take_shlf then b_shelf else a_shelf): Int
             val c_added = (if take_shlf then b_added else a_added): Int
             val c_opened = (if take_shlf then b_opened else a_opened): Int
             val c_shelf_modified = (if take_shlf then b_shelf_modified else a_shelf_modified): Int
             val c_file_size = (if take_size then b_file_size else a_file_size): Int
             val c_cover = (if take_size then b_cover else a_cover): Int
             val c_done = (if take_size then b_done else a_done): Int
             val c_minutes_read = (if take_time then b_minutes_read else a_minutes_read): Int
             val c_pages_read = (if take_time then b_pages_read else a_pages_read): Int
             val @(c_title, c_title_len) = _choose(take_titl, a_title, a_title_len, b_title, b_title_len)
             val changed = BookImage(c_author, c_author_len, c_id_high, c_id_low, c_collections, c_collections_modified, c_minutes_elsewhere, c_pages_elsewhere, c_finished_at, c_finished_modified, c_chapter, c_chapters, c_page, c_pages, c_anchor, c_place_modified, c_place_declined, c_series, c_series_len, c_series_number, c_shelf, c_added, c_opened, c_shelf_modified, c_file_size, c_cover, c_done, c_minutes_read, c_pages_read, c_title, c_title_len)
             val book = book_of_image(changed)
             val () = book_image_free(changed)
           in BookRecord(ver, minver, book, extras) end)
    end

end
