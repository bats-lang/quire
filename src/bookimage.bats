(* the bit of the group TITL in a mask of groups *)
#pub fn book_group_titl (): int

implement book_group_titl () = 1024

(* every group *)
#pub fn book_group_all (): int

implement book_group_all () = 2047

(* The numbers of kept in the groups of keep_mask, and the others' of other *)
#pub fun book_numbers_merge (kept: book_numbers, other: book_numbers, keep_mask: int): book_numbers

implement book_numbers_merge (kept, other, keep_mask) = @{id_high = (if $AR.band_int_int(keep_mask, 2) <> 0 then kept.id_high else other.id_high), id_low = (if $AR.band_int_int(keep_mask, 2) <> 0 then kept.id_low else other.id_low), collections = (if $AR.band_int_int(keep_mask, 4) <> 0 then kept.collections else other.collections), collections_modified = (if $AR.band_int_int(keep_mask, 4) <> 0 then kept.collections_modified else other.collections_modified), minutes_elsewhere = (if $AR.band_int_int(keep_mask, 8) <> 0 then kept.minutes_elsewhere else other.minutes_elsewhere), pages_elsewhere = (if $AR.band_int_int(keep_mask, 8) <> 0 then kept.pages_elsewhere else other.pages_elsewhere), finished_at = (if $AR.band_int_int(keep_mask, 16) <> 0 then kept.finished_at else other.finished_at), finished_modified = (if $AR.band_int_int(keep_mask, 16) <> 0 then kept.finished_modified else other.finished_modified), chapter = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.chapter else other.chapter), chapters = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.chapters else other.chapters), page = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.page else other.page), pages = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.pages else other.pages), anchor = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.anchor else other.anchor), place_modified = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.place_modified else other.place_modified), place_declined = (if $AR.band_int_int(keep_mask, 32) <> 0 then kept.place_declined else other.place_declined), series_number = (if $AR.band_int_int(keep_mask, 64) <> 0 then kept.series_number else other.series_number), shelf = (if $AR.band_int_int(keep_mask, 128) <> 0 then kept.shelf else other.shelf), added = (if $AR.band_int_int(keep_mask, 128) <> 0 then kept.added else other.added), opened = (if $AR.band_int_int(keep_mask, 128) <> 0 then kept.opened else other.opened), shelf_modified = (if $AR.band_int_int(keep_mask, 128) <> 0 then kept.shelf_modified else other.shelf_modified), file_size = (if $AR.band_int_int(keep_mask, 256) <> 0 then kept.file_size else other.file_size), cover = (if $AR.band_int_int(keep_mask, 256) <> 0 then kept.cover else other.cover), done = (if $AR.band_int_int(keep_mask, 256) <> 0 then kept.done else other.done), minutes_read = (if $AR.band_int_int(keep_mask, 512) <> 0 then kept.minutes_read else other.minutes_read), pages_read = (if $AR.band_int_int(keep_mask, 512) <> 0 then kept.pages_read else other.pages_read)}

(* The groups whose fields differ in two images, as a mask *)
#pub fun book_image_diff (first: !book_image, second: !book_image): int

implement book_image_diff (first, second) =
  case+ first of
  | BookImage(a_author, a_author_len, a_id_high, a_id_low, a_collections, a_collections_modified, a_minutes_elsewhere, a_pages_elsewhere, a_finished_at, a_finished_modified, a_chapter, a_chapters, a_page, a_pages, a_anchor, a_place_modified, a_place_declined, a_series, a_series_len, a_series_number, a_shelf, a_added, a_opened, a_shelf_modified, a_file_size, a_cover, a_done, a_minutes_read, a_pages_read, a_title, a_title_len) =>
    (case+ second of
     | BookImage(b_author, b_author_len, b_id_high, b_id_low, b_collections, b_collections_modified, b_minutes_elsewhere, b_pages_elsewhere, b_finished_at, b_finished_modified, b_chapter, b_chapters, b_page, b_pages, b_anchor, b_place_modified, b_place_declined, b_series, b_series_len, b_series_number, b_shelf, b_added, b_opened, b_shelf_modified, b_file_size, b_cover, b_done, b_minutes_read, b_pages_read, b_title, b_title_len) => let
         val m_auth = (if (~_arrays_equal(a_author, a_author_len, b_author, b_author_len)) then 1 else 0): int
         val m_book = (if (a_id_high <> b_id_high) || (a_id_low <> b_id_low) then 2 else 0): int
         val m_coll = (if (a_collections <> b_collections) || (a_collections_modified <> b_collections_modified) then 4 else 0): int
         val m_else = (if (a_minutes_elsewhere <> b_minutes_elsewhere) || (a_pages_elsewhere <> b_pages_elsewhere) then 8 else 0): int
         val m_fnsh = (if (a_finished_at <> b_finished_at) || (a_finished_modified <> b_finished_modified) then 16 else 0): int
         val m_plce = (if (a_chapter <> b_chapter) || (a_chapters <> b_chapters) || (a_page <> b_page) || (a_pages <> b_pages) || (a_anchor <> b_anchor) || (a_place_modified <> b_place_modified) || (a_place_declined <> b_place_declined) then 32 else 0): int
         val m_seri = (if (~_arrays_equal(a_series, a_series_len, b_series, b_series_len)) || (a_series_number <> b_series_number) then 64 else 0): int
         val m_shlf = (if (a_shelf <> b_shelf) || (a_added <> b_added) || (a_opened <> b_opened) || (a_shelf_modified <> b_shelf_modified) then 128 else 0): int
         val m_size = (if (a_file_size <> b_file_size) || (a_cover <> b_cover) || (a_done <> b_done) then 256 else 0): int
         val m_time = (if (a_minutes_read <> b_minutes_read) || (a_pages_read <> b_pages_read) then 512 else 0): int
         val m_titl = (if (~_arrays_equal(a_title, a_title_len, b_title, b_title_len)) then 1024 else 0): int
       in $AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int($AR.add_int_int(0, m_auth), m_book), m_coll), m_else), m_fnsh), m_plce), m_seri), m_shlf), m_size), m_time), m_titl) end)

(* The image of a book *)
#pub fun book_image_of {x:bookx} (book: !bookv(x)): book_image

implement book_image_of {x} (book) =
  case+ book of
  | BookV(b_author, b_id_high, b_id_low, b_collections, b_collections_modified, b_minutes_elsewhere, b_pages_elsewhere, b_finished_at, b_finished_modified, b_chapter, b_chapters, b_page, b_pages, b_anchor, b_place_modified, b_place_declined, b_series, b_series_number, b_shelf, b_added, b_opened, b_shelf_modified, b_file_size, b_cover, b_done, b_minutes_read, b_pages_read, b_title) => let
      val (_ | len_author) = blist_len(b_author)
      val v_author = blist_to_array(b_author)
      val v_id_high = int32_value(b_id_high)
      val v_id_low = int32_value(b_id_low)
      val v_collections = int32_value(b_collections)
      val v_collections_modified = int32_value(b_collections_modified)
      val v_minutes_elsewhere = int32_value(b_minutes_elsewhere)
      val v_pages_elsewhere = int32_value(b_pages_elsewhere)
      val v_finished_at = int32_value(b_finished_at)
      val v_finished_modified = int32_value(b_finished_modified)
      val v_chapter = int32_value(b_chapter)
      val v_chapters = int32_value(b_chapters)
      val v_page = int32_value(b_page)
      val v_pages = int32_value(b_pages)
      val v_anchor = int32_value(b_anchor)
      val v_place_modified = int32_value(b_place_modified)
      val v_place_declined = int32_value(b_place_declined)
      val (_ | len_series) = blist_len(b_series)
      val v_series = blist_to_array(b_series)
      val v_series_number = int32_value(b_series_number)
      val v_shelf = int32_value(b_shelf)
      val v_added = int32_value(b_added)
      val v_opened = int32_value(b_opened)
      val v_shelf_modified = int32_value(b_shelf_modified)
      val v_file_size = int32_value(b_file_size)
      val v_cover = int32_value(b_cover)
      val v_done = int32_value(b_done)
      val v_minutes_read = int32_value(b_minutes_read)
      val v_pages_read = int32_value(b_pages_read)
      val (_ | len_title) = blist_len(b_title)
      val v_title = blist_to_array(b_title)
    in BookImage(v_author, len_author, v_id_high, v_id_low, v_collections, v_collections_modified, v_minutes_elsewhere, v_pages_elsewhere, v_finished_at, v_finished_modified, v_chapter, v_chapters, v_page, v_pages, v_anchor, v_place_modified, v_place_declined, v_series, len_series, v_series_number, v_shelf, v_added, v_opened, v_shelf_modified, v_file_size, v_cover, v_done, v_minutes_read, v_pages_read, v_title, len_title) end

