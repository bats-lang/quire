#pub fun app_css (): string(12032)

implement app_css () = "@font-face{font-family:Literata;src:url(literata-latin.woff2) format('woff2');font-style:normal;font-weight:200 900;font-display:swap}@font-face{font-family:Literata;src:url(literata-italic-latin.woff2) format('woff2');font-style:italic;font-weight:200 900;font-display:swap}@font-face{font-family:Inter;src:url(inter-latin.woff2) format('woff2');font-style:normal;font-weight:100 900;font-display:swap}.th-light{--bg:#faf8f5;--fg:#2a2a2a;--muted:#6b6b6b;--card:#ffffff;--line:#dddddd;--bar:#333333;--barfg:#ffffff;--accent:#2f6f4f;--accentfg:#ffffff;--hl:rgba(255,213,79,.55)}.th-sepia{--bg:#f0e6d2;--fg:#3b2f22;--muted:#6e5e4a;--card:#f7efdf;--line:#d6c7a8;--bar:#4a3b2a;--barfg:#f7efdf;--accent:#7a4f1d;--accentfg:#ffffff;--hl:rgba(214,160,60,.45)}.th-dark{--bg:#1e1e1e;--fg:#e2e2e2;--muted:#a0a0a0;--card:#2a2a2a;--line:#3d3d3d;--bar:#111111;--barfg:#e2e2e2;--accent:#7fc49b;--accentfg:#10231a;--hl:rgba(255,213,79,.35)}body{margin:0;background:#faf8f5}.app{min-height:100vh;background:var(--bg);color:var(--fg);font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.4}[data-hide='1'],[hidden]{display:none!important}button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}button:focus-visible,.card:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.lib{display:flex;flex-direction:column;max-width:800px;margin:0 auto;padding:max(12px,env(safe-area-inset-top)) 16px 24px;box-sizing:border-box;min-height:100vh}.lib.drag{outline:3px dashed var(--accent);outline-offset:-8px}.bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--line)}.ttl{font-family:Literata,Georgia,serif;font-weight:bold;font-size:22px;flex:1;margin:0}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;border-radius:6px;background:var(--card);border:1px solid var(--line);color:var(--fg);box-sizing:border-box;font-size:15px;position:relative;overflow:hidden}.btn-p{background:var(--accent);color:var(--accentfg);border-color:var(--accent)}.btn input[type=file]{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;cursor:pointer;font-size:0}.ibtn{min-width:44px;min-height:44px;font-size:20px;border-radius:6px}.search{flex-basis:100%;min-height:40px;padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--fg);font:inherit;box-sizing:border-box}.banner{display:flex;gap:8px;align-items:center;margin:8px 0;padding:10px 12px;border-radius:6px;background:#fbe3e1;color:#6b1d16;border:1px solid #e6aaa4}.banner span{flex:1}.imp{margin:8px 0;padding:10px 12px;border-radius:6px;background:var(--card);border:1px solid var(--line)}.imp-n{font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.imp-s{color:var(--muted);font-size:14px}.imp-bar{height:6px;background:var(--line);border-radius:3px;margin-top:6px;overflow:hidden}.imp-fill{height:100%;background:var(--accent);width:0}.list{display:flex;flex-direction:column}.card{width:100%;text-align:left;display:flex;gap:12px;align-items:center;padding:10px;margin:6px 0;border:1px solid var(--line);border-radius:8px;background:var(--card);cursor:pointer;min-height:44px}.card *{pointer-events:none}.cov{width:48px;height:72px;object-fit:cover;border-radius:3px;flex:none;background:var(--line)}.cinfo{flex:1;min-width:0}.bt{font-weight:bold;font-size:16px;overflow:hidden;text-overflow:ellipsis}.ba{color:var(--muted);font-size:14px}.prog{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;margin-top:4px}.pbar{flex:1;max-width:160px;height:5px;background:var(--line);border-radius:3px;overflow:hidden}.pfill{height:100%;background:var(--accent)}.empty{text-align:center;color:var(--muted);padding:16px;margin-top:15vh;font-size:18px;font-style:italic}.ovl{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:20;display:flex;align-items:center;justify-content:center}.menu,.mbox{background:var(--card);color:var(--fg);border-radius:8px;padding:8px;min-width:200px;max-width:min(92vw,420px);display:flex;flex-direction:column;box-shadow:0 4px 24px rgba(0,0,0,.3)}.mi{text-align:left;padding:12px 14px;min-height:44px;border-radius:6px}.mi:hover{background:var(--line)}.menu .mi.btn{border:0;background:none;justify-content:flex-start;padding:12px 14px;min-height:44px;font-size:inherit;color:var(--fg)}.mbox{padding:16px;gap:12px}.mtitle{font-weight:bold;font-size:18px}.mta{min-height:120px;font:inherit;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg)}.mbtns{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.info{position:fixed;inset:0;z-index:15;background:var(--bg);overflow:auto;padding:max(12px,env(safe-area-inset-top)) 16px 24px}.info-in{max-width:600px;margin:0 auto;display:flex;flex-direction:column;gap:8px}.info-in>.btn{align-self:flex-start}.icov{width:160px;max-width:50vw;max-height:300px;object-fit:contain;align-self:center;border-radius:4px}.it{font-family:Literata,Georgia,serif;font-size:22px;font-weight:bold}.irow{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:8px 0;color:var(--muted)}.irow b{color:var(--fg);font-weight:normal}.rv{display:flex;flex-direction:column;height:100vh;position:relative;background:var(--bg);color:var(--fg)}.top,.bot{display:flex;align-items:center;gap:4px;padding:2px 6px;background:var(--bar);color:var(--barfg);z-index:3}.top{position:absolute;top:0;left:0;right:0;padding-top:max(2px,env(safe-area-inset-top))}.bot{position:absolute;bottom:0;left:0;right:0;flex-wrap:wrap;padding-bottom:max(2px,env(safe-area-inset-bottom))}.top .ibtn,.bot .ibtn{color:var(--barfg)}.ctitle{flex:1;font-size:14px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.pinfo{font-size:13px;white-space:nowrap;flex:1;text-align:center}.chrome-off .top,.chrome-off .bot{display:none}.caf{flex:1;overflow:hidden;box-sizing:border-box;padding-top:max(48px,env(safe-area-inset-top));padding-bottom:max(36px,env(safe-area-inset-bottom));column-fill:auto;column-gap:0;column-width:100vw;font-family:Literata,Georgia,serif;font-size:18px;line-height:1.6;outline:none}.caf>*{max-width:38rem;margin-left:auto;margin-right:auto;box-sizing:border-box}.caf p{margin:0 auto .8em;text-align:justify;hyphens:auto}.caf h1,.caf h2,.caf h3{text-align:center;margin-top:1.5em;margin-bottom:.5em;break-after:avoid}.caf hr{border:none;border-top:1px solid var(--line);margin:2em auto;max-width:200px}.caf img{max-width:100%;max-height:calc(100vh - 110px);object-fit:contain;height:auto;display:block;margin:0 auto;break-inside:avoid}.caf table{display:block;overflow-x:auto;max-width:100%;border-collapse:collapse}.caf td,.caf th{border:1px solid var(--line);padding:2px 6px}.caf a{color:var(--accent);text-decoration:underline;cursor:pointer}.caf pre{white-space:pre-wrap}.caf blockquote{margin:1em auto;font-style:italic}::highlight(bats-mark-1){background-color:var(--hl)}::highlight(bats-mark-2){background-color:#ffb300;color:#000}.scr{flex-basis:100%;display:flex;align-items:center;gap:8px;padding:4px 6px}.trk{flex:1;position:relative;height:28px;cursor:pointer;touch-action:none}.trk-l{position:absolute;left:0;right:0;top:12px;height:4px;background:rgba(255,255,255,.3);border-radius:2px;pointer-events:none}.trk-f{position:absolute;left:0;top:12px;height:4px;background:var(--accent);border-radius:2px;pointer-events:none}.tick{position:absolute;top:8px;width:2px;height:12px;background:rgba(255,255,255,.6);pointer-events:none}.thumb{position:absolute;top:6px;width:16px;height:16px;margin-left:-8px;border-radius:50%;background:var(--barfg);pointer-events:none}.tip{position:absolute;bottom:30px;transform:translateX(-50%);background:var(--card);color:var(--fg);padding:2px 8px;border-radius:4px;font-size:13px;white-space:nowrap;pointer-events:none}.pct{font-size:13px;min-width:3em;text-align:right}.pback{position:absolute;left:12px;bottom:90px;z-index:4;background:var(--accent);color:var(--accentfg);border-radius:20px;padding:8px 14px;box-shadow:0 2px 8px rgba(0,0,0,.3);min-height:40px}.seltb{position:absolute;left:50%;bottom:90px;transform:translateX(-50%);z-index:5;display:flex;gap:2px;background:var(--bar);color:var(--barfg);border-radius:8px;padding:4px;box-shadow:0 2px 8px rgba(0,0,0,.3)}.seltb button{padding:8px 12px;min-height:40px;color:var(--barfg);background:none;border:0;border-radius:6px}.seltb button:hover{background:rgba(255,255,255,.15)}.panel{position:fixed;top:0;bottom:0;left:0;width:min(420px,100vw);z-index:12;background:var(--card);color:var(--fg);display:flex;flex-direction:column;box-shadow:2px 0 16px rgba(0,0,0,.3);padding-top:env(safe-area-inset-top)}.panel-r{left:auto;right:0}.ph{display:flex;align-items:center;gap:6px;padding:6px 8px;border-bottom:1px solid var(--line)}.ph .grow{flex:1;font-weight:bold}.tab{padding:8px 10px;border-radius:6px;min-height:40px}.tab[aria-selected=true]{background:var(--line)}.plist{flex:1;overflow:auto;padding:4px 0}.pi{display:block;width:100%;text-align:left;padding:10px 14px;min-height:44px;box-sizing:border-box;border-bottom:1px solid var(--line)}.pi[aria-current=true]{font-weight:bold;background:var(--line)}.pi1{padding-left:30px}.pi2{padding-left:46px}.pi3{padding-left:62px}.snip{display:block;color:var(--muted);font-size:13px;margin-top:2px}.hq{border-left:3px solid var(--accent);padding-left:8px;font-style:italic}.hn{display:block;margin-top:4px;font-size:14px}.hbtns{display:flex;gap:6px;margin-top:6px}.hbtns button{padding:4px 10px;border:1px solid var(--line);border-radius:4px;font-size:13px}.sheet{position:fixed;left:0;right:0;bottom:0;z-index:12;background:var(--card);color:var(--fg);padding:12px 16px max(16px,env(safe-area-inset-bottom));box-shadow:0 -2px 16px rgba(0,0,0,.3);display:flex;flex-direction:column;gap:10px;max-width:520px;margin:0 auto;border-radius:12px 12px 0 0}.srow{display:flex;align-items:center;gap:10px}.slabel{width:7em;color:var(--muted);font-size:14px}.srow input[type=range]{flex:1;min-height:32px;accent-color:var(--accent)}.sval{width:3em;text-align:right;font-size:14px}.seg{display:flex;gap:4px;flex:1;flex-wrap:wrap}.seg button{flex:1;padding:8px 6px;border:1px solid var(--line);border-radius:6px;min-height:40px;font-size:14px}.seg button[aria-pressed=true]{background:var(--accent);color:var(--accentfg);border-color:var(--accent)}.link{color:var(--accent);text-decoration:underline;align-self:flex-start;padding:6px 0}.sbar{display:flex;gap:6px;align-items:center;padding:6px 8px;border-bottom:1px solid var(--line)}.sbar input{flex:1;min-height:40px;padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}.snav{display:flex;align-items:center;justify-content:center;gap:8px;padding:6px;border-top:1px solid var(--line);font-size:14px}@media (max-width:480px){.lib{padding-left:10px;padding-right:10px}.ttl{font-size:20px;flex:1 1 calc(100% - 60px)}.bar>.ibtn{order:1}.bar>.btn{order:2;padding:8px 9px;font-size:14px}.bar>.search{order:3}}.hrow{border-bottom:1px solid var(--line);padding:8px 12px}.hgo{display:block;width:100%;text-align:left;padding:4px 0}.pi.hgo{padding:10px 14px}.pi.hgo .snip{color:var(--fg);font-size:14px;margin-top:0;line-height:1.45}.snavf span{white-space:nowrap;padding:0 4px}.hgo *{pointer-events:none}.hq{display:block}.hbtn{padding:4px 10px;border:1px solid var(--line);border-radius:4px;font-size:13px;min-height:32px}.grp{font-weight:bold;padding:12px 12px 4px;color:var(--muted);font-size:13px;letter-spacing:.04em;text-transform:uppercase}.caf.rtl>*{direction:rtl}.caf figure{margin:1em auto}.caf sup,.caf sub{line-height:0}.snavf{position:absolute;left:50%;top:max(56px,calc(env(safe-area-inset-top) + 54px));transform:translateX(-50%);z-index:6;display:flex;gap:6px;align-items:center;background:var(--bar);color:var(--barfg);border-radius:22px;padding:2px 8px;box-shadow:0 2px 8px rgba(0,0,0,.3);font-size:14px}.snavf .ibtn{color:var(--barfg)}.tabs{display:flex;gap:4px}"
