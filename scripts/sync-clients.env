# The OAuth clients Quire signs in with (#184, #200, #239): public values (each
# ships in every page and APK), so they are committed here, not kept as
# repository variables, and a local build reads the same ones as CI.
# scripts/sync-clients.sh reads this file; sync-identity.yml checks it.
# Plain NAME=value lines: no quotes, no spaces.

# Google Cloud project Quire, the "Quire web" Web application client:
# the browser's Google Drive and the Android app's Use Android both sign
# in with it
GOOGLE_WEB_CLIENT_ID=162611675413-0501vhs5c72jqbu1e2brlj7tcf9rv5og.apps.googleusercontent.com

# The "Quire Android (upload key)" Android client: package
# dev.middlefield.quire and the upload key's SHA-1. Google matches an
# Android client by package and SHA-1, so the app never sends this ID;
# it is kept as the record of what is registered
GOOGLE_ANDROID_CLIENT_ID=162611675413-4lrhctdkos4hrhceg9uvcu48j4q9vvc3.apps.googleusercontent.com

# Play's app signing key's SHA-1 (Play Console, Protected with Play, Play
# app signing, App signing key certificate): a Play install is signed
# with it, so it has an Android client of its own ("Quire Android (Play)")
PLAY_SIGNING_SHA1=5A:48:49:13:05:9A:CC:B8:B3:81:35:81:67:BA:1E:DD:66:0C:27:97

# The Dropbox app "Quire reader" (#239): its app key, which the PKCE
# sign-in sends as client_id (Dropbox's sync needs no secret)
DROPBOX_CLIENT_ID=qypgdkl7ay6om4g
