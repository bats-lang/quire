diff --git a/packages/google-sign-in/example/android/app/build.gradle b/packages/google-sign-in/example/android/app/build.gradle
index ff91947f..591d7e43 100644
--- a/packages/google-sign-in/example/android/app/build.gradle
+++ b/packages/google-sign-in/example/android/app/build.gradle
@@ -1,10 +1,10 @@
 apply plugin: 'com.android.application'
 
 android {
-    namespace = "com.example.plugin"
+    namespace = "io.github.batslang.googlesignindemo"
     compileSdk = rootProject.ext.compileSdkVersion
     defaultConfig {
-        applicationId "com.example.plugin"
+        applicationId "io.github.batslang.googlesignindemo"
         minSdkVersion rootProject.ext.minSdkVersion
         targetSdkVersion rootProject.ext.targetSdkVersion
         versionCode 1
@@ -16,7 +16,20 @@ android {
             ignoreAssetsPattern = '!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~'
         }
     }
+    // Demo only: a throwaway keystore, so the APK's SHA-1 is the one the
+    // demo's Android OAuth client is registered with (bats-lang/quire#316).
+    signingConfigs {
+        debug {
+            storeFile file('demo.jks')
+            storePassword 'g5jwKdpyVSP_qUndX1wglzKQ'
+            keyAlias 'demo'
+            keyPassword 'g5jwKdpyVSP_qUndX1wglzKQ'
+        }
+    }
     buildTypes {
+        debug {
+            signingConfig signingConfigs.debug
+        }
         release {
             minifyEnabled false
             proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
