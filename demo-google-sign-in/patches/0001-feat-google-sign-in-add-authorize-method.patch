+package io.capawesome.capacitorjs.plugins.googlesignin.classes.options;
+
+import androidx.annotation.NonNull;
+import com.getcapacitor.PluginCall;
+
+public class AuthorizeOptions {
+
+    private final boolean interactive;
+
+    private final boolean offlineAccess;
+
+    public AuthorizeOptions(@NonNull PluginCall call) {
+        this.interactive = getInteractiveFromCall(call);
+        this.offlineAccess = getOfflineAccessFromCall(call);
+    }
+
+    public boolean getInteractive() {
+        return interactive;
+    }
+
+    public boolean getOfflineAccess() {
+        return offlineAccess;
+    }
+
+    private static boolean getInteractiveFromCall(@NonNull PluginCall call) {
+        return call.getBoolean("interactive", true);
+    }
+
+    private static boolean getOfflineAccessFromCall(@NonNull PluginCall call) {
+        return call.getBoolean("offlineAccess", false);
+    }
+}
