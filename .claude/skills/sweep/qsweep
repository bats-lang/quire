    # Only a worktree whose pull request merged and whose tip is in origin/main can be removed, and never the one that merged last (_clean_decide).
    if [ "$_why" = "pull request merged" ] && git -C "$_main" merge-base --is-ancestor "$(git -C "$w" rev-parse HEAD)" origin/main 2>/dev/null; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$_merged_at" "$w" "$b" "$_sz" "$_why" >> /tmp/qsweep-finished.tsv
    else
      echo "REUSABLE WORKTREE $w [${b}] ${_sz} MB ($_why): the next ticket is a new branch in it (git checkout -B <branch> origin/main); it is never removed by 'qsweep clean'"
    fi
  else _kept=$((_kept+1)); fi
done < <(git -C $_main worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{b=$2; sub(/^refs\/heads\//,"",b)} /^detached/{b="(detached)"} /^$/{print w"\t"b; w="";b=""}')
