{
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(uvx pitboss clean-container)",
      "Bash(uvx pitboss clean-container --no-dry-run)",
      "Bash(uvx --from git+https://github.com/dev-skill-up/pitboss pitboss clean-container)",
      "Bash(uvx --from git+https://github.com/dev-skill-up/pitboss pitboss clean-container --no-dry-run)",
      "Bash(grep -q tracefs /proc/mounts || mount -t tracefs nodev /sys/kernel/tracing)",
      "Bash(mount -t tracefs nodev /sys/kernel/tracing)",
      "Edit(/.claude/rules/ci.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__add_issue_comment|mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tests/static/guidelines.py\" --hook"
          }
        ]
      }
    ]
  }
}
