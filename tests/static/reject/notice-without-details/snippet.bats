(* A failure's details with HandedBookNotAdded left out: its banner would
   offer no Copy details, and a report of it would carry nothing (#507) *)
fn _static_details (failed: failure): detail_source =
  case+ failed of
  | LibraryNotAdded() => FromFailureAlone()
  | SettingsNotRead() => FromFailureAlone()
  | CataloguesNotRead() => FromFailureAlone()
  | DictionariesNotRead() => FromFailureAlone()
  | AnnotationsNotRead() => FromFailureAlone()
  | BookFileLost() => FromFailureAlone()
  | BookStorageFailed() => FromFailureAlone()
  | BookReplacedElsewhere() => FromFailureAlone()
  | PartNotRead() => FromFailureAlone()
  | StorageFull() => FromFailureAlone()
  | RecordFromNewerQuire() => FromFailureAlone()
  | RecordDamaged() => FromFailureAlone()
  | RecordNotQuires() => FromFailureAlone()
  | BooksNotRead() => FromFailureAlone()
  | BooksNotReadCanSetAside() => FromFailureAlone()
  | AsideNotRead() => FromFailureAlone()
  | AsideIncomplete() => FromFailureAlone()
  | DetailsDamaged() => FromFailureAlone()
  | CollectionsNotRead() => FromFailureAlone()
  | CollectionsNotReadCanSetAside() => FromFailureAlone()
  | NarrationNotPlayable() => FromFailureAlone()
  | RotationNotLockable() => FromFailureAlone()
  | GrantNotTaken() => FromFailureAlone()
  | GrantNoAnswer() => FromFailureAlone()
  | TextNotCopied() => FromFailureAlone()
  | DetailsNotCopied() => FromFailureAlone()
  | HighlightNotSelected() => FromFailureAlone()
  | SelectionNotEnded() => FromFailureAlone()
