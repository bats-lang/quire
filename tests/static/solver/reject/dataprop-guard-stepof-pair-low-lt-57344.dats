dataprop STEPOF(cells, tsrc, int, int, int) =
  | {cells:cells}{order:byteorder}{i,n:nat | n <= i + 1}{first:int}
    STEPOF_truncated(cells, SrcUtf16(order), i, i + 1, 65533) of (NTH(cells, i, first), CLEN(cells, n))
  | {cells:cells}{order:byteorder}{i:nat}{unit:int | unit < 55296 || 57344 <= unit}
    STEPOF_unit(cells, SrcUtf16(order), i, i + 2, unit) of UNIT16(cells, order, i, unit)
  | {cells:cells}{order:byteorder}{i:nat}{high,low:int | 55296 <= high; high < 56320; 56320 <= low; low < 57344}
    STEPOF_pair(cells, SrcUtf16(order), i, i + 4, 65536 + 1024 * (high - 55296) + (low - 56320)) of (UNIT16(cells, order, i, high), UNIT16(cells, order, i + 2, low))
  | {cells:cells}{order:byteorder}{i,n:nat | n <= i + 3}{high:int | 55296 <= high; high < 56320}
    STEPOF_high_at_end(cells, SrcUtf16(order), i, i + 2, 65533) of (UNIT16(cells, order, i, high), CLEN(cells, n))
  | {cells:cells}{order:byteorder}{i:nat}{high,next:int | 55296 <= high; high < 56320; next < 56320 || 57344 <= next}
    STEPOF_high_alone(cells, SrcUtf16(order), i, i + 2, 65533) of (UNIT16(cells, order, i, high), UNIT16(cells, order, i + 2, next))
  | {cells:cells}{order:byteorder}{i:nat}{low:int | 56320 <= low; low < 57344}
    STEPOF_low_alone(cells, SrcUtf16(order), i, i + 2, 65533) of UNIT16(cells, order, i, low)
  | {cells:cells}{page:codepage}{i:nat}{value:int | 0 <= value; value < 128}
    STEPOF_ascii(cells, SrcTable(page), i, i + 1, value) of NTH(cells, i, value)
  | {cells:cells}{page:codepage}{i:nat}{value:int | 128 <= value; value < 256}{point:int}
    STEPOF_table(cells, SrcTable(page), i, i + 1, point) of (NTH(cells, i, value), TABLEAT(page, value, point))

prfn probe_low_lt_57344 {cells:cells}{order:byteorder}{i:nat}{high,low:int | 55296 <= high; high < 56320; 56320 <= low; low < (57344) + 1} (premise1: UNIT16(cells, order, i, high), premise2: UNIT16(cells, order, i + 2, low)): STEPOF(cells, SrcUtf16(order), i, i + 4, 65536 + 1024 * (high - 55296) + (low - 56320)) = STEPOF_pair{cells}{order}{i}{high,low}(premise1, premise2)
